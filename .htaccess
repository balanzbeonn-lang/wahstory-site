# ==================================================
# ENABLE REWRITE ENGINE
# ==================================================
RewriteEngine On


# ==================================================
# BLOCK LINKEDIN PREVIEW BOT
# ==================================================
RewriteCond %{HTTP_USER_AGENT} LinkedInBot [NC]
RewriteRule ^ - [F,L]


# ==================================================
# FORCE HTTPS (optional - already handled in Apache config)
# ==================================================
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ==================================================
# REMOVE TRAILING SLASH (EXCEPT DIRECTORIES)
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ==================================================
# SPECIFIC ROUTES (MUST COME BEFORE CATCH-ALL)
# ==================================================
RewriteRule ^story/(.*)$ /single.php?slug=$1 [NC,L]
RewriteRule ^blog/(.*)$ /blog.php?slug=$1 [NC,L]
RewriteRule ^stories/(.*)$ /stories.php?slug=$1 [NC,L]
RewriteRule ^search/(.*)$ /stories.php?query=$1 [NC,L]
RewriteRule ^login$ /login.php [L]
RewriteRule ^logout$ /logout.php [QSA,L]

# ==================================================
# OLD REDIRECTS
# ==================================================
RewriteRule ^wahspotlight/nominee/(.*)$ /story/$1 [R=301,L]

# ==================================================
# CORE CATCH-ALL (PUT THIS LAST)
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php?slug=$1 [QSA,L]

# ==================================================
# CUSTOM 404 PAGE
# ==================================================
ErrorDocument 404 /custom-404-notFound.php

# ==================================================
# SECURITY SETTINGS
# ==================================================
Options -Indexes
